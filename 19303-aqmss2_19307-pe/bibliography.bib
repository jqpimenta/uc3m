}

@article{chiodaSpilloversConditionalCash2016,
	title = {Spillovers from conditional cash transfer programs: \textit{{Bolsa} {Família}} and crime in urban {Brazil}},
	volume = {54},
	issn = {0272-7757},
	shorttitle = {Spillovers from conditional cash transfer programs},
	url = {https://www.sciencedirect.com/science/article/pii/S0272775715000552},
	doi = {10.1016/j.econedurev.2015.04.005},
	abstract = {This paper investigates the impact of conditional cash transfer (CCT) programs on crime. Making use of a unique dataset combining detailed school characteristics with geo-referenced crime information from the city of São Paulo, Brazil, we estimate the contemporaneous effect of the Bolsa Família program on crime. We address the endogeneity of CCT coverage by exploiting the 2008 expansion of the program to adolescents aged 16 and 17. We construct an instrument that combines the timing of expansion with the initial demographic composition of schools to identify plausibly exogenous variation in the number of children covered by Bolsa Família. We find a robust and significant negative impact of Bolsa Família on crime. Incapacitation from time spent in school does not seem to be an important driving force behind the results.},
	urldate = {2026-06-09},
	journal = {Economics of Education Review},
	author = {Chioda, Laura and De Mello, João M. P. and Soares, Rodrigo R.},
	month = oct,
	year = {2016},
	keywords = {Brazil, Education, Bolsa Família, Conditional cash transfer, Crime, Schooling},
	pages = {306--320},
	file = {ScienceDirect Full Text PDF:/Users/jii/Zotero/storage/U8DXELL4/Chioda et al. - 2016 - Spillovers from conditional cash transfer programs Bolsa Família and crime in urban Brazil.pdf:application/pdf;ScienceDirect Snapshot:/Users/jii/Zotero/storage/YBE7X7RZ/S0272775715000552.html:text/html},
}

