@article{machadoConditionalCashTransfer2018,
	title = {Conditional cash transfer programme: {Impact} on homicide rates and hospitalisations from violence in {Brazil}},
	volume = {13},
	issn = {1932-6203},
	shorttitle = {Conditional cash transfer programme},
	url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0208925},
	doi = {10.1371/journal.pone.0208925},
	abstract = {Background Homicide kills more people than war globally and is associated with income inequality. In Brazil, one of the most unequal countries of the world, the homicide rate is four times higher than the world average. Establishing if the Brazilian conditional cash transfer programme [Bolsa Familia Programme (BFP)], the largest in the world, is associated with a reduction in the rate of homicide is relevant for violence prevention programs. We aimed to assess the effect of BFP coverage on homicide and hospitalization rates from violence. Methods BFP coverage and rates of homicide (overall and disaggregated by sex and age) and hospitalizations from violence from all 5,507 Brazilian municipalities between 2004 and 2012 were explored using multivariable negative binomial regression models with fixed effect for panel data. Robustness of results was explored using sensitivity analyses such as difference-in-difference models. Findings Homicide rates and hospitalization from violence decreased as BFP coverage in the target population increased. For each percent increase in the uptake of the BFP, the homicide rate decreased by 0.3\% (Rate Ratio:0.997; 95\%CI:0.996–0.997) and hospitalizations from violence by 0.4\% (RR: 0.996;95\%CI:0.995–0.996). Rates of homicide and hospitalizations from violence were also negatively associated with the duration of BFP coverage. When, coverage of the target population was at least 70\% for one-year, hospitalizations from violence decreased by 8\%; two-years 14\%, three-years 20\%, and four years 25\%. Interpretation Our results support the hypothesis that conditional cash transfer programs might have as an additional benefit the prevention of homicides and hospitalizations from violence. Social protection interventions could contribute to decrease levels of violence in low-and-middle-income-countries through reducing poverty and/or socioeconomic inequalities.},
	language = {en},
	number = {12},
	urldate = {2026-06-09},
	journal = {PLOS ONE},
	publisher = {Public Library of Science},
	author = {Machado, Daiane Borges and Rodrigues, Laura C. and Rasella, Davide and Barreto, Maurício Lima and Araya, Ricardo},
	month = dec,
	year = {2018},
	keywords = {Brazil, Educational attainment, Firearms, Homicide, Policing, Socioeconomic aspects of health, Urbanization, Violent crime},
	pages = {e0208925},
	file = {Full Text PDF:/Users/jii/Zotero/storage/2WRNLJU4/Machado et al. - 2018 - Conditional cash transfer programme Impact on homicide rates and hospitalisations from violence in.pdf:application/pdf},
}

@article{lanceConditionalCashTransfers2014,
	title = {Conditional {Cash} {Transfers} and the {Effect} on {Recent} {Murder} {Rates} in {Brazil} and {Mexico}},
	volume = {56},
	issn = {1531-426X, 1548-2456},
	url = {https://www.cambridge.org/core/journals/latin-american-politics-and-society/article/abs/conditional-cash-transfers-and-the-effect-on-recent-murder-rates-in-brazil-and-mexico/C96AB7E2677C24D0FC67D7168571E63A},
	doi = {10.1111/j.1548-2456.2014.00221.x},
	abstract = {This article examines whether conditional cash transfer (CCT) programs have had a significant effect on reducing murder rates in Mexico and Brazil, using time-series municipal-level data on murders in both countries. The findings, over the period 2005–8, show that the greater the proportion of beneficiaries enrolled in a CCT program in each municipality, the lower the number of murders. There are, however, important differences between the two countries, with a much larger effect in Brazil than in Mexico. This holds even when controlling for GDP and levels of development.},
	language = {en},
	number = {1},
	urldate = {2026-06-09},
	journal = {Latin American Politics and Society},
	author = {Lance, Justin Earl},
	month = apr,
	year = {2014},
	pages = {55--72},
	file = {PDF:/Users/jii/Zotero/storage/9QQBYCQ5/Lance - 2014 - Conditional Cash Transfers and the Effect on Recent Murder Rates in Brazil and Mexico.pdf:application/pdf},
}

@article{zizumbo-colungaUnintendedConsequencesConditional2023,
	title = {The {Unintended} {Consequences} of {Conditional} {Cash} {Transfer} {Programs} for {Violence}: {Experimental} and {Survey} {Evidence} from {Mexico} and the {Americas}},
	volume = {65},
	issn = {1531-426X, 1548-2456},
	shorttitle = {The {Unintended} {Consequences} of {Conditional} {Cash} {Transfer} {Programs} for {Violence}},
	url = {https://www.cambridge.org/core/journals/latin-american-politics-and-society/article/abs/unintended-consequences-of-conditional-cash-transfer-programs-for-violence-experimental-and-survey-evidence-from-mexico-and-the-americas/984F2B2AB7FF917B1C9D113190004FD1},
	doi = {10.1017/lap.2022.67},
	abstract = {Because conditional cash transfer programs (CCTs) can address the deep roots of violence, many scholars and policymakers have assumed them to be an effective and innocuous tool to take on the issue. I argue that while CCTs may have positive economic effects, they can also trigger social discord, criminal predation, and political conflict and, in doing so, increase violence. To test this claim, I take advantage of the exogenous shock caused by the randomized expansion of Mexico’s flagship CCT, PROGRESA/Oportunidades. I find that the experimental introduction of the program increased rather than decreased violence. Then, I analyze all the data compiled by LAPOP on the issue over the years. I find that, other things constant, Latin Americans are more exposed to violence and insecurity when they participate in CCTs than when they do not. These findings urge us to reconsider the effects of social programs on violence.},
	language = {en},
	number = {3},
	urldate = {2026-06-09},
	journal = {Latin American Politics and Society},
	author = {Zizumbo-Colunga, Daniel},
	month = aug,
	year = {2023},
	keywords = {CCT, homicides, Mexico, PROGRESA, social programs},
	pages = {47--71},
}

@article{aransiolaEffectAbsoluteRelative2021,
